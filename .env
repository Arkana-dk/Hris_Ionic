# ========================================
# 🌐 HAKUNAMATATA.MY.ID - DIRECT CONNECTION
# ========================================
# Backend Laravel Remote: https://hakunamatata.my.id
# Direct connection (no proxy)

# API Configuration - Direct to hakunamatata.my.id
VITE_API_URL=https://hakunamatata.my.id/api
VITE_API_BASE_URL=https://hakunamatata.my.id

# Sanctum Configuration
VITE_SANCTUM_CSRF_COOKIE_URL=https://hakunamatata.my.id/sanctum/csrf-cookie

# API Mode: DIRECT
VITE_USE_REAL_API=true
VITE_USE_LOCAL_API=false

# ========================================
# 🚫 LOCALHOST DISABLED (Uncomment to use local)
# ========================================
# VITE_API_URL=http://localhost:8000/api
# VITE_API_BASE_URL=http://localhost:8000
# VITE_SANCTUM_CSRF_COOKIE_URL=http://localhost:8000/sanctum/csrf-cookie
# VITE_USE_LOCAL_API=true

# App Configuration
VITE_APP_NAME=HRIS Mobile
VITE_APP_VERSION=1.0.0

# Timeout Configuration (milliseconds)
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=3

# Debug Mode
VITE_DEBUG_MODE=true
